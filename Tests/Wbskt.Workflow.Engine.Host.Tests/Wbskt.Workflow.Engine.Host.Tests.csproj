<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hosts\Wbskt.Auth.Host\Wbskt.Auth.Host.csproj" />
    <ProjectReference Include="..\..\Hosts\Wbskt.Management.Host\Wbskt.Management.Host.csproj" />
    <ProjectReference Include="..\..\Hosts\Wbskt.Socket.Host\Wbskt.Socket.Host.csproj" />
    <ProjectReference Include="..\..\Hosts\Wbskt.Workflow.Engine.Host\Wbskt.Workflow.Engine.Host.csproj" />
    <ProjectReference Include="..\..\Wbskt.Workflow\Wbskt.Workflow.csproj" />
    <ProjectReference Include="..\..\Events\Wbskt.EventBus\Wbskt.EventBus.csproj" />
    <ProjectReference Include="..\..\Events\Wbskt.Events\Wbskt.Events.csproj" />
    <ProjectReference Include="..\..\Wbskt.Workflow.Abstraction\Wbskt.Workflow.Abstraction.csproj" />
    <!-- So the shipped examples are smoke-tested as exported, not as a copy that cannot drift with them. -->
    <ProjectReference Include="..\..\Tools\Wbskt.Workflow.Exporter\Wbskt.Workflow.Exporter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Abstraction\Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

