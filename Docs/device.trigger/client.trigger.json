{
    "type": "trigger:device",
    "meta": {
        "label": "Device Trigger",
        "description": "Fires when a device emits telemetry or a property changes.",
        "category": "trigger",
        "icon": "bolt",
        "color": {
            "header": "#C05A1F",
            "border": "#E07030",
            "badge": "LIVE"
        }
    },
    "ports": {
        "outputs": [
            {
                "id": "on_telemetry",
                "label": "On Telemetry",
                "description": "Fires on every data packet",
                "type": "flow",
                "position": "right",
                "dot": {
                    "color": "#E07030"
                }
            },
            {
                "id": "on_property_change",
                "label": "On Property Change",
                "description": "Triggers on specific attribute updates",
                "type": "flow",
                "position": "right",
                "dot": {
                    "color": "#E07030"
                }
            }
        ]
    },
    "elements": [
        {
            "id": "target_device",
            "label": "Target Device",
            "type": "select:client",
            "clientFilter": "native",
            "placeholder": "Select a device...",
            "required": true,
            "icon": "chip"
        }
    ]
}