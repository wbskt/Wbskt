@page "/login"
@layout EmptyLayout
@inject Webskt.Dashboard.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="container">
    <div class="row justify-content-center align-items-center vh-100">
        <div class="col-md-4">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">WBSKT</h2>
                        <p class="text-muted">Platform Management Console</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger py-2 small">@_errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email Address</label>
                        <input type="email" class="form-control" @bind="_email" placeholder="admin@wbskt.com" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Password</label>
                        <input type="password" class="form-control" @bind="_password" />
                    </div>

                    <button class="btn btn-primary w-100 fw-bold py-2" @onclick="HandleLogin" disabled="@(_isBusy)">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Sign In
                    </button>
                </div>
            </div>
            <div class="text-center mt-4">
                <p class="small text-muted">&copy; 2026 WBSKT Infrastructure</p>
            </div>
        </div>
    </div>
</div>

@code {
    private string _email = "admin@wbskt.com";
    private string _password = "";
    private string? _errorMessage;
    private bool _isBusy;

    private async Task HandleLogin()
    {
        _isBusy = true;
        _errorMessage = null;

        var success = await AuthService.LoginAsync(_email, _password);

        if (success)
        {
            Navigation.NavigateTo("");
        }
        else
        {
            _errorMessage = "Invalid email or password.";
        }

        _isBusy = false;
    }
}
