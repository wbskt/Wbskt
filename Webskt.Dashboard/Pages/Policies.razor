@page "/policies"
@inject ApiClient Api

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Registration Policies</h3>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i class="bi bi-plus-lg"></i> Create Policy
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>PIN</th>
                    <th>Auto-Approval</th>
                    <th>Max Clients</th>
                    <th>Created</th>
                    <th class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_policies == null)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                        </td>
                    </tr>
                }
                else if (!_policies.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No policies found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var p in _policies)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@p.Name</td>
                            <td><code class="bg-light px-2 py-1 rounded">@p.Pin</code></td>
                            <td>
                                <span class="badge @(p.AutoApproval ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                    @(p.AutoApproval ? "Enabled" : "Manual")
                                </span>
                            </td>
                            <td>@(p.MaxClients?.ToString() ?? "Unlimited")</td>
                            <td class="text-muted small">@p.CreatedAt.ToString("g")</td>
                            <td class="pe-4 text-end">
                                <button class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showCreateModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">New Registration Policy</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Policy Name</label>
                        <input type="text" class="form-control" @bind="_newPolicy.Name" placeholder="e.g. Factory Batch A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Max Clients (Optional)</label>
                        <input type="number" class="form-control" @bind="_newPolicy.MaxClients" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_newPolicy.AutoApproval" id="autoApprove" />
                        <label class="form-check-label small" for="autoApprove">Auto-Approve Registrations</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" @onclick="() => _showCreateModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="CreatePolicy" disabled="@_isSaving">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyCollection<RegistrationPolicyResponse>? _policies;
    private bool _showCreateModal;
    private bool _isSaving;
    private NewPolicyModel _newPolicy = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPolicies();
    }

    private async Task LoadPolicies()
    {
        _policies = await Api.GetPoliciesAsync();
    }

    private void ShowCreateModal()
    {
        _newPolicy = new();
        _showCreateModal = true;
    }

    private async Task CreatePolicy()
    {
        if (string.IsNullOrWhiteSpace(_newPolicy.Name)) return;

        _isSaving = true;
        try
        {
            await Api.CreatePolicyAsync(new RegistrationPolicyRequest(_newPolicy.Name, _newPolicy.MaxClients, _newPolicy.AutoApproval));
            _showCreateModal = false;
            await LoadPolicies();
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class NewPolicyModel
    {
        public string Name { get; set; } = "";
        public int? MaxClients { get; set; }
        public bool AutoApproval { get; set; } = true;
    }
}
