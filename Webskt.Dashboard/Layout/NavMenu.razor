<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">WBSKT</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column mt-3">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3 mt-2">
            <div class="text-uppercase text-muted x-small px-3 mb-1 fw-bold" style="font-size: 0.7rem;">Management</div>
            <NavLink class="nav-link" href="policies">
                <i class="bi bi-shield-check me-2" aria-hidden="true"></i> Policies
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="devices">
                <i class="bi bi-cpu me-2" aria-hidden="true"></i> Devices
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}