# Copy to .env (same directory) and fill in real values before `docker compose up`.
# Never commit the real .env file.

# Container registry and image tag the VM pulls from. CI (.github/workflows/build-images.yml)
# publishes <REGISTRY>/wbskt-<service> tagged sha-<short-commit>; deploy/scripts/deploy.sh
# rewrites IMAGE_TAG here on every deploy, so a bare `docker compose ps` on the VM keeps
# referring to whatever is actually running. Leave IMAGE_TAG=latest for local development, where
# the build: keys apply instead.
REGISTRY=ghcr.io/wbskt
IMAGE_TAG=latest
# The Angular console ships from its own repo on its own cadence, so it gets its own tag.
CONSOLE_IMAGE_TAG=latest

# Replica counts per scalable tier. These live here rather than being passed as `--scale` on the
# command line because `docker compose up -d <service>` converges to the declared count - a deploy
# that forgot the flag would quietly shrink a scaled tier back to one instance.
# engine > 1 additionally requires the remediation prerequisite in
# Docs\Workflow.Engine.V3.Remediation.Plan.md.
SOCKET_REPLICAS=1
MANAGEMENT_REPLICAS=1
ENGINE_REPLICAS=1

# Public DNS zone; console.${DOMAIN}, auth.${DOMAIN}, api.${DOMAIN}, ws.${DOMAIN} must all resolve
# to this host.
DOMAIN=example.com
ACME_EMAIL=ops@example.com
# Uncomment while iterating to avoid Let's Encrypt production rate limits:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# SQL Server (container+volume for staging; swap sql: service for a VM-installed/managed
# instance in prod - both are reachable as sql:1433 on the backend network).
SQL_SA_PASSWORD=Change_Me_123!

# RabbitMQ (non-guest creds required outside Development).
RABBITMQ_USER=wbskt
RABBITMQ_PASSWORD=change-me-rabbitmq

# Auth JWT signing key - shared by all 4 hosts, must be long/random in production.
JWT_KEY=change-me-to-a-long-random-string

# Console origin allowed to call Auth/Management via CORS (browser-facing, so it's the public
# console URL, not the internal service name).
CONSOLE_ORIGIN=https://console.example.com

# Shared secret the engine's InboundApiKeyMiddleware requires on every api/inbound/* call.
# Management sends it automatically (WorkflowEngineApiKeyHandler); anything else on the backend
# network calling the engine directly must send it too.
ENGINE_INBOUND_API_KEY=change-me-engine-api-key
