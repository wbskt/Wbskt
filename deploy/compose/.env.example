# Copy to .env (same directory) and fill in real values before `docker compose up`.
# Never commit the real .env file.

# Container registry and image tag the VM pulls from. CI (.github/workflows/build-images.yml)
# publishes <REGISTRY>/wbskt-<service> tagged sha-<short-commit>; deploy/scripts/deploy.sh
# rewrites IMAGE_TAG here on every deploy, so a bare `docker compose ps` on the VM keeps
# referring to whatever is actually running. Leave IMAGE_TAG=latest for local development, where
# the build: keys apply instead.
REGISTRY=ghcr.io/wbskt
IMAGE_TAG=latest
# The Angular console ships from its own repo on its own cadence, so it gets its own tag.
CONSOLE_IMAGE_TAG=latest

# Replica counts per scalable tier. These live here rather than being passed as `--scale` on the
# command line because `docker compose up -d <service>` converges to the declared count - a deploy
# that forgot the flag would quietly shrink a scaled tier back to one instance.
# engine > 1 additionally requires the remediation prerequisite in
# Docs\Workflow.Engine.V3.Remediation.Plan.md.
SOCKET_REPLICAS=1
MANAGEMENT_REPLICAS=1
ENGINE_REPLICAS=1

# Public DNS zone; console.${DOMAIN}, auth.${DOMAIN}, api.${DOMAIN}, ws.${DOMAIN} must all resolve
# to this host.
DOMAIN=example.com
ACME_EMAIL=ops@example.com
# Uncomment while iterating to avoid Let's Encrypt production rate limits:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# SQL Server (container+volume for staging; swap sql: service for a VM-installed/managed
# instance in prod - both are reachable as sql:1433 on the backend network).
SQL_SA_PASSWORD=Change_Me_123!

# RabbitMQ (non-guest creds required outside Development).
RABBITMQ_USER=wbskt
RABBITMQ_PASSWORD=change-me-rabbitmq

# JWT signing keys - one EC P-256 private key per issuing host, never shared. The auth host signs
# user tokens, the management host signs device tokens; every other host only holds public keys,
# which it fetches from the issuer's /.well-known/jwks.json. Generate each with:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64 -w0
# Rotating one: see "Rotating a JWT signing key" in deploy/README.md.
AUTH_JWT_SIGNING_KEY=
MANAGEMENT_JWT_SIGNING_KEY=
# Only while rotating: the retired key's public half, so tokens it signed stay valid until they expire.
AUTH_JWT_PREVIOUS_PUBLIC_KEY=
MANAGEMENT_JWT_PREVIOUS_PUBLIC_KEY=

# Console origin allowed to call Auth/Management via CORS (browser-facing, so it's the public
# console URL, not the internal service name).
CONSOLE_ORIGIN=https://console.example.com

# Optional extra browser origins allowed to call Auth/Management, comma-separated. Empty by default.
# Use it to point a console you run yourself at this backend, e.g. `ng serve` on your machine:
#   CORS_EXTRA_ORIGINS=http://localhost:4200
# Mail links still go to CONSOLE_ORIGIN. Clear it again before public launch.
CORS_EXTRA_ORIGINS=

# --- Outbound mail from the auth host -------------------------------------------------------------
# REQUIRED in any deployment that accepts sign-ups. Sign-in requires a confirmed email address, so
# with no relay configured nobody who registers can ever log in - the auth host logs an error saying
# exactly that at startup rather than failing quietly.
#
# Used for invitations, email confirmation and password resets. Links in that mail point at
# CONSOLE_ORIGIN above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# The envelope sender. Most relays reject mail without one, and it must be an address the relay is
# willing to send as.
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Wbskt

# Shared secret the engine's InboundApiKeyMiddleware requires on every api/inbound/* call.
# Management sends it automatically (WorkflowEngineApiKeyHandler); anything else on the backend
# network calling the engine directly must send it too.
ENGINE_INBOUND_API_KEY=change-me-engine-api-key

# --- Backups (deploy/scripts/backup.sh, run nightly from cron) ------------------------------------
# Where backup.sh writes on this host before uploading. Pruned to BACKUP_RETENTION_DAYS.
BACKUP_DIR=/var/backups/wbskt
BACKUP_RETENTION_DAYS=14

# How backups leave this machine. REQUIRED: backup.sh refuses to run without it, because a backup
# sitting on the same VM does not survive the failure it exists for.
#
# Must be a single executable taking the backup directory as its one argument - a value with spaces
# in it is NOT parsed as a command line, so wrap anything more complex in a small script:
#
#   #!/usr/bin/env bash
#   exec rclone copy "$1" remote:wbskt-backups --immutable
#
# BACKUP_UPLOAD_CMD=/usr/local/bin/wbskt-backup-upload

# Set only while you are still setting the upload up. Leaving it true means you have no off-box
# backups at all.
# BACKUP_ALLOW_LOCAL_ONLY=false

# Same single-executable rule as above; receives the failure message as its one argument. Backup
# failures are silent otherwise, which is the usual way this goes wrong. deploy/scripts/alert.sh
# raises it in this stack's Alertmanager, so it reaches ALERT_EMAIL_TO / ALERT_WEBHOOK_URL below.
# BACKUP_ALERT_CMD=/home/<user>/Wbskt/deploy/scripts/alert.sh

# --- Observability (otel-collector, Prometheus, Alertmanager, Loki, Tempo, Grafana) ----------------
# Grafana listens on the VM's loopback only; see "Observability" in deploy/README.md.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
METRICS_RETENTION=15d

# Where alerts go. Set at least one, or alerts fire and reach nobody. Email reuses the SMTP_* relay
# below; the webhook takes anything that accepts Alertmanager's webhook payload.
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
