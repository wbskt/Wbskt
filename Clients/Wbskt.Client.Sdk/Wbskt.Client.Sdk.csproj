<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 for the LTS most boards (Raspberry Pi OS, Debian) ship; net10.0 for the hosts and tests. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsPackable>true</IsPackable>
    <PackageId>Wbskt.Client</PackageId>
    <Version>$(SdkPackageVersion)</Version>
    <Description>Connect a device, script or service to Wbskt: register with a policy PIN, hold a WebSocket open, send readings and receive commands. Buffers while offline and reconnects with jitter.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wbskt.Protocol\Wbskt.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wbskt.Host.Tests" />
  </ItemGroup>

</Project>
