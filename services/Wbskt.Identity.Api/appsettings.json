{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5070"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%LogPath%/CoreLog_.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 15,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithThreadId"]
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=Wbskt.Database;Integrated Security=True;Trusted_Connection=True;"
  },
  "Jwt": {
    "UserTokenKey": "<-----------------DummyUserTokenKey----------------->",
    "CoreServerTokenKey": "<-----------------DummyCoreServerTokenKey----------------->",
    "SocketServerTokenKey": "<-----------------DummySocketServerTokenKey----------------->",
    "ClientServerTokenKey": "<-----------------DummyClientServerTokenKey----------------->",
    "Issuer": "wbskt.com",
    "Audience": "wbskt.com"
  },
  "AuthServer": {
    "Authority": "https://localhost:7172",
    "Audience": "wbskt_api"
  }
}
