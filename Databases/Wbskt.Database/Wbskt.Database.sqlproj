<Project Sdk="MSBuild.Sdk.SqlProj/4.4.0">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <SqlServerVersion>Sql150</SqlServerVersion>
        <IncludeCompositeObjects>true</IncludeCompositeObjects>
        <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
    </PropertyGroup>

    <ItemGroup>
        <SqlFiles Include="StoredProcedures\*.sql" />
        <SqlFiles Include="Tables\*.sql" />
        <SqlFiles Include="Types\*.sql" />
        <SqlFiles Include="Types\UserDefinedTableTypes\*.sql" />
        <SqlFiles Include="Views\*.sql" />
    </ItemGroup>

    <ItemGroup>
        <PostDeploy Include="Scripts\Script.PostDeployment.sql"/>
        <PreDeploy Include="Scripts\Script.PreDeployment.sql"/>
    </ItemGroup>

    <!-- Passwords for the per-host SQL logins the post-deployment script creates. Empty skips them. -->
    <ItemGroup>
        <SqlCmdVariable Include="ManagementHostPassword">
            <DefaultValue></DefaultValue>
            <Value>$(SqlCmdVar__1)</Value>
        </SqlCmdVariable>
        <SqlCmdVariable Include="EngineHostPassword">
            <DefaultValue></DefaultValue>
            <Value>$(SqlCmdVar__2)</Value>
        </SqlCmdVariable>
    </ItemGroup>

</Project>
