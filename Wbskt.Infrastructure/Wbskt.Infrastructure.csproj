<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Events\Wbskt.EventBus\Wbskt.EventBus.csproj" />
      <ProjectReference Include="..\Events\Wbskt.Events\Wbskt.Events.csproj" />
      <ProjectReference Include="..\Models\Wbskt.Models\Wbskt.Models.csproj" />
      <ProjectReference Include="..\Wbskt.Primitives\Wbskt.Primitives.csproj" />
    </ItemGroup>

    <!-- This project hosts the shared middleware and ApiControllerBase used by every web host.
         Safe here because the only non-web consumer (Wbskt.Workflow) is itself referenced solely
         by web hosts and test projects, and every deployed container uses the aspnet base image. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- Microsoft.Extensions.Configuration.*, Hosting.Abstractions, Logging.Abstractions and
         AspNetCore.Http.Abstractions are all supplied by the framework reference above, so they are
         deliberately not listed here. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

</Project>
